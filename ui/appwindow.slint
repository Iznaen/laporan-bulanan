import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ProfileScreen } from "profile_screen.slint";
import { DailyScreen } from "daily_screen.slint";
import { HistoryScreen } from "history_screen.slint";
import { DailyLogEntry } from "types.slint";

export enum Tab { Daily, History, Settings }

// A single bottom navigation tab button.
component NavItem {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    horizontal-stretch: 1;

    TouchArea {
        clicked => { root.clicked(); }

        VerticalBox {
            padding: 6px;
            spacing: 2px;
            alignment: center;

            Text {
                text: label;
                font-size: 11px;
                horizontal-alignment: center;
                color: root.active ? #1565C0 : #757575;
                font-weight: root.active ? 700 : 400;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Laporan Bulanan";
    preferred-width: 360px;
    preferred-height: 640px;

    // ── Navigation ───────────────────────────────────────────────────────
    in-out property <Tab> active-tab: Tab.Daily;

    // ── Profile ──────────────────────────────────────────────────────────
    in-out property <string> profile-name;
    in-out property <string> profile-ni;
    in-out property <string> profile-role;
    in-out property <string> profile-work-unit;
    in-out property <string> profile-signature-path;
    in-out property <string> profile-status-message;
    callback save-profile();
    callback pick-signature();

    // ── Daily log ────────────────────────────────────────────────────────
    in-out property <string> daily-date;
    in property <string> daily-date-display;
    in property <bool> daily-is-weekend;
    in-out property <string> daily-check-in;
    in-out property <string> daily-check-out;
    in-out property <string> daily-total-hours;
    in-out property <string> daily-attendance-note;
    in-out property <string> daily-activity-desc;
    in-out property <string> daily-activity-output;
    in-out property <string> daily-activity-note;
    in-out property <string> daily-photo-path;
    in property <string> daily-status-message;
    in property <string> daily-total-hours-error;
    callback save-daily-log();
    callback pick-photo();
    callback navigate-prev-day();
    callback navigate-next-day();
    callback recalculate-hours();

    // ── History ──────────────────────────────────────────────────────────
    in property <string> history-period-label;
    in property <[DailyLogEntry]> history-entries;
    in property <string> history-export-status;
    callback navigate-prev-month();
    callback navigate-next-month();
    callback history-entry-selected(string);
    callback history-export-excel();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ── Main content area ────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;

            if root.active-tab == Tab.Daily : DailyScreen {
                width: 100%;
                height: 100%;
                date <=> root.daily-date;
                date-display: root.daily-date-display;
                is-weekend: root.daily-is-weekend;
                check-in <=> root.daily-check-in;
                check-out <=> root.daily-check-out;
                total-hours <=> root.daily-total-hours;
                attendance-note <=> root.daily-attendance-note;
                activity-desc <=> root.daily-activity-desc;
                activity-output <=> root.daily-activity-output;
                activity-note <=> root.daily-activity-note;
                photo-path <=> root.daily-photo-path;
                status-message: root.daily-status-message;
                total-hours-error: root.daily-total-hours-error;
                save-daily-log => { root.save-daily-log(); }
                pick-photo => { root.pick-photo(); }
                prev-day => { root.navigate-prev-day(); }
                next-day => { root.navigate-next-day(); }
                recalculate-hours => { root.recalculate-hours(); }
            }

            if root.active-tab == Tab.History : HistoryScreen {
                width: 100%;
                height: 100%;
                period-label: root.history-period-label;
                entries: root.history-entries;
                export-status: root.history-export-status;
                prev-month => { root.navigate-prev-month(); }
                next-month => { root.navigate-next-month(); }
                entry-selected(date) => { root.history-entry-selected(date); }
                export-excel => { root.history-export-excel(); }
            }

            if root.active-tab == Tab.Settings : ProfileScreen {
                width: 100%;
                height: 100%;
                name <=> root.profile-name;
                ni <=> root.profile-ni;
                role <=> root.profile-role;
                work-unit <=> root.profile-work-unit;
                signature-path <=> root.profile-signature-path;
                status-message <=> root.profile-status-message;
                save-profile => { root.save-profile(); }
                pick-signature => { root.pick-signature(); }
            }
        }

        // ── Bottom navigation bar ────────────────────────────────────────
        Rectangle {
            height: 56px;
            background: #ffffff;

            Rectangle { y: 0; height: 1px; background: #e0e0e0; }

            HorizontalBox {
                padding: 0px;
                spacing: 0px;

                NavItem {
                    label: "Harian";
                    active: root.active-tab == Tab.Daily;
                    clicked => { root.active-tab = Tab.Daily; }
                }
                NavItem {
                    label: "Riwayat";
                    active: root.active-tab == Tab.History;
                    clicked => { root.active-tab = Tab.History; }
                }
                NavItem {
                    label: "Pengaturan";
                    active: root.active-tab == Tab.Settings;
                    clicked => { root.active-tab = Tab.Settings; }
                }
            }
        }
    }
}
