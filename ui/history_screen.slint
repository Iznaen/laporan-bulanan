import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { DailyLogEntry } from "types.slint";

// A single clickable row in the history list.
component HistoryRow {
    in property <DailyLogEntry> entry;
    callback selected(string); // emits entry.date

    preferred-height: 68px;

    Rectangle {
        border-radius: 6px;
        background: root.entry.is-weekend ? #f5f5f5 :
                    root.entry.has-data   ? #e8f5e9 : #fafafa;
        border-color: #e0e0e0;
        border-width: 1px;

        // Content layer
        HorizontalBox {
            padding: 10px;
            spacing: 8px;

            // Date + day column
            VerticalBox {
                width: 90px;
                spacing: 2px;
                alignment: center;

                Text {
                    text: entry.date-display;
                    font-size: 13px;
                    font-weight: 700;
                    color: entry.is-weekend ? #9e9e9e : #212121;
                }
                Text {
                    text: entry.day-name;
                    font-size: 11px;
                    color: #aaaaaa;
                }
            }

            // Status / summary column
            VerticalBox {
                spacing: 2px;
                alignment: center;
                horizontal-stretch: 1;

                if entry.is-weekend : Text {
                    text: "Libur / Akhir Pekan";
                    font-size: 12px;
                    color: #bdbdbd;
                }
                if !entry.is-weekend && entry.has-data : Text {
                    text: entry.check-in + " – " + entry.check-out
                          + (entry.total-hours != "" ? "  (" + entry.total-hours + ")" : "");
                    font-size: 12px;
                    color: #424242;
                    overflow: elide;
                }
                if !entry.is-weekend && entry.has-data && entry.activity-desc != "" : Text {
                    text: entry.activity-desc;
                    font-size: 11px;
                    color: #757575;
                    overflow: elide;
                }
                if !entry.is-weekend && !entry.has-data : Text {
                    text: "Belum diisi";
                    font-size: 12px;
                    color: #cccccc;
                }
            }
        }

        // Click-capture layer (on top)
        TouchArea {
            clicked => { root.selected(root.entry.date); }
        }
    }
}

export component HistoryScreen {
    in property <string> period-label;
    in property <[DailyLogEntry]> entries;
    in property <string> export-status;
    in property <string> export-pdf-status;

    callback prev-month();
    callback next-month();
    callback entry-selected(string); // emits date YYYY-MM-DD
    callback export-excel();
    callback export-pdf();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ── Month navigation bar ─────────────────────────────────────────
        HorizontalBox {
            height: 52px;
            padding: 8px;
            spacing: 8px;
            alignment: center;

            Button { text: "◀"; width: 44px; clicked => { root.prev-month(); } }

            Text {
                text: root.period-label;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button { text: "▶"; width: 44px; clicked => { root.next-month(); } }
        }

        // ── Export bar ───────────────────────────────────────────────────
        HorizontalBox {
            padding: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            alignment: start;

            Button {
                text: "Ekspor Excel (.xlsx)";
                clicked => { root.export-excel(); }
            }
            
            Button {
                text: "Ekspor PDF (.pdf)";
                clicked => { root.export-pdf(); }
            }

            Text {
                text: root.export-status != "" ? root.export-status : root.export-pdf-status;
                font-size: 12px;
                color: #2e7d32;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }

        Rectangle { height: 1px; background: #e0e0e0; }

        // ── Scrollable list ──────────────────────────────────────────────
        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                padding: 12px;
                spacing: 6px;

                for entry in root.entries : HistoryRow {
                    entry: entry;
                    selected(date) => { root.entry-selected(date); }
                }
            }
        }
    }
}
