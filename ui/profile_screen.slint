import { Button, ScrollView, VerticalBox } from "std-widgets.slint";
import { LabeledField } from "widgets.slint";

// The full profile/settings screen.
export component ProfileScreen {
    in-out property <string> name;
    in-out property <string> ni;
    in-out property <string> role;
    in-out property <string> work-unit;
    in-out property <string> signature-path;
    in-out property <string> status-message;

    callback save-profile();
    callback pick-signature();

    VerticalBox {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Pengaturan Profil";
            font-size: 20px;
            font-weight: 700;
        }

        ScrollView {
            preferred-height: root.height - 48px;

            VerticalBox {
                spacing: 14px;
                padding: 0px;

                LabeledField { label: "Nama"; value <=> root.name; }
                LabeledField { label: "NI (Nomor Induk)"; value <=> root.ni; }
                LabeledField { label: "Jabatan"; value <=> root.role; }
                LabeledField { label: "Unit Kerja"; value <=> root.work-unit; }

                VerticalBox {
                    spacing: 4px;
                    padding: 0px;

                    Text {
                        text: "Tanda Tangan";
                        font-size: 12px;
                        color: #888888;
                    }
                    LabeledField {
                        label: "Path File TTD";
                        value <=> root.signature-path;
                        read-only: true;
                    }
                    Button {
                        text: "Pilih Gambar TTD";
                        clicked => { root.pick-signature(); }
                    }
                }

                Button {
                    text: "Simpan Profil";
                    clicked => { root.save-profile(); }
                }

                if root.status-message != "" : Text {
                    text: root.status-message;
                    font-size: 13px;
                    color: #2e7d32;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
